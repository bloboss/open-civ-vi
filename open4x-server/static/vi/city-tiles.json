{
  "$schema": "city-tiles/v1",
  "$doc": {
    "summary": "Per-city tile ownership maps used by the city hex view renderer.",
    "fields": {
      "cities[].id":           "City id matching city-data.json cities[].id.",
      "cities[].tiles[].offset": "[dq, dr] axial offset from the city center tile.",
      "cities[].tiles[].status": "'center' | 'working' | 'idle' — determines fill color in the city hex view.",
      "note": "The renderer converts (cityQ + offset[0], cityR + offset[1]) to world coords with X wrapping."
    }
  },

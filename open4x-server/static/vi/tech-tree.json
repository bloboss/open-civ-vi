{
  "$schema": "tech-tree/v1",
  "$doc": {
    "summary": "Technology tree data + active research queue.",
    "fields": {
      "techs[].id":        "Unique camelCase identifier referenced by RESEARCH_QUEUE and prerequisites.",
      "techs[].name":      "Display name shown in the tree and drawer.",
      "techs[].cost":      "Base science cost to complete (integer).",
      "techs[].progress":  "Science already accumulated — only present on the 'current' tech.",
      "techs[].unlocks":   "Short human-readable string listing what this tech enables.",
      "techs[].era":       "Era column this node belongs to: Ancient | Classical | Medieval | Renaissance | Industrial | Modern+",
      "techs[].status":    "'done' | 'current' | 'available' | 'locked'",
      "techs[].prereqs":   "Array of tech ids that must be 'done' before this can be started (optional).",
      "research_queue":    "Ordered array of tech ids queued after the current one (index 0 = next up)."
    }
  },
